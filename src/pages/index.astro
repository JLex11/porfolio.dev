---
import Layout from '@/layouts/Layout.astro'

import AboutMe from '@/components/AboutMe.astro'
import Experience from '@/components/Experience.astro'
import GithubContributions from '@/components/GithubContributions.astro'
import Hero from '@/components/Hero.astro'
import Projects from '@/components/Projects.astro'
import SectionContainer from '@/components/SectionContainer.astro'
import ValueOffer from '@/components/ValueOffer.astro'

import Briefcase from '@/components/icons/Briefcase.astro'
import CodeIcon from '@/components/icons/Code.astro'
import GitHubIcon from '@/components/icons/GitHub.astro'
import People from '@/components/icons/People.astro'
import ProfileCheck from '@/components/icons/ProfileCheck.astro'

import type { ui } from '@/i18n/ui'
import { useTranslations } from '@/i18n/utils'

export const prerender = true

const currentLocale = Astro.currentLocale as keyof typeof ui
const t = useTranslations(currentLocale)
---

<Layout title={t('seo.title')} description={t('seo.description')}>
  <main class='px-4 flex flex-col gap-48 mt-24 animate-fade-in-up opacity-0 translate-y-5'>
    <div>
      <SectionContainer class='py-16 md:pt-28 md:pb-0'>
        <Hero />
      </SectionContainer>
    </div>
    <SectionContainer id='experiencia'>
      <h2 class='animate-in-view flex items-center mb-7 text-3xl font-semibold gap-x-3 text-black/80 dark:text-white'>
        <Briefcase class='size-8' />
        {t('section.experience.title')}
      </h2>
      <Experience />
    </SectionContainer>

    <SectionContainer id='proyectos'>
      <h2 class='animate-in-view flex items-center mb-7 text-3xl font-semibold gap-x-3 text-black/80 dark:text-white'>
        <CodeIcon class='size-7' />
        {t('section.projects.title')}
      </h2>
      <Projects />
    </SectionContainer>

    <SectionContainer id='sobre-mi'>
      <h2 class='animate-in-view flex items-center mb-7 text-3xl font-semibold gap-x-8 text-black/80 dark:text-white'>
        <ProfileCheck class='size-8' />
        {t('section.about.title')}
      </h2>
      <AboutMe />
    </SectionContainer>

    <SectionContainer id='valor' observable={false}>
      <h2 class='animate-in-view flex items-center mb-7 text-3xl font-semibold gap-x-3 text-black/80 dark:text-white'>
        <People class='size-8' />
        {t('section.value.title')}
      </h2>
      <ValueOffer />
    </SectionContainer>

    <SectionContainer id='github'>
      <h2 class='animate-in-view flex items-center mb-7 text-3xl font-semibold gap-x-3 text-black/80 dark:text-white'>
        <GitHubIcon class='size-8' />
        {t('section.github.title')}
      </h2>
      <GithubContributions server:defer>
        <div slot="fallback" class="contrib-card animate-pulse rounded-[1.25rem] border border-white/55 bg-white/45 px-5 pt-4 pb-6 shadow-[0_10px_40px_-10px_rgba(59,130,246,0.25),inset_0_1px_0_rgba(255,255,255,0.6)] [backdrop-filter:blur(18px)_saturate(1.3)] dark:border-slate-400/15 dark:bg-slate-900/45 dark:shadow-[0_10px_40px_-10px_rgba(59,130,246,0.20),inset_0_1px_0_rgba(255,255,255,0.05)]">
          <div class="mb-4 flex items-center gap-2 border-b border-slate-400/18 pb-3">
            <span class="ml-2 font-mono text-[0.8rem] text-gray-700/80 dark:text-slate-200/70">@JLex11</span>
          </div>
          <div class="mb-4">
            <p class="text-[0.9rem] text-slate-600/90 dark:text-slate-300/85">Cargando contribuciones...</p>
          </div>
          <div class="h-[128px] w-full rounded-lg bg-slate-200/60 dark:bg-slate-700/60" />
        </div>
      </GithubContributions>
    </SectionContainer>
  </main>
</Layout>

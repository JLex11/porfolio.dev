---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Reference {
	name: string
	picture: ImageMetadata
	relation: string
	linkedin: string
	text: string
}

interface Props {
	title: string
	company: string
	companyLink?: string
	description: string
	date: string
	references?: Reference[]
}

const { title, company, companyLink, description, date, references = [] } = Astro.props
---

<article
  class="relative mx-12 pb-12 before:absolute before:-left-8.75 before:block before:h-full before:border-l-2 before:border-black/20 dark:before:border-white/15 before:content-['']"
>
  <header class='relative pb-8'>
    <span class='text-yellow-400 -left-10.5 absolute rounded-full text-5xl leading-none'>&bull;</span>
    <h3 class='text-xl font-bold text-yellow-400'>{title}</h3>
    <h4 class='font-semibold text-xl text-gray-600 dark:text-white'>
      {
        companyLink ? (
          <a href={companyLink} rel='noreferrer' target='_blank' class='hover:underline'>
            {company}
          </a>
        ) : (
          company
        )
      }
    </h4>
    <time class='p-0 m-0 text-sm text-gray-600/80 dark:text-white/80'>{date}</time>
  </header>

  <div
    class='relative flex flex-col gap-2 pb-8 text-gray-600 dark:text-gray-300 [&>span>strong]:text-blue-500'
  >
    <span set:html={description} />
  </div>

  {
    references.length > 0 && (
      <ul class='flex flex-wrap gap-4'>
        {references.map(({ name, picture, relation, linkedin, text }, index) => (
          <li class='animate-in-view-right flex-1 min-w-70 max-w-120' style={`--stagger: ${index}`}>
            <article class='flex flex-col gap-2 h-full border text-black dark:text-white dark:border-gray-800 border-black/20 bg-black/5 dark:bg-white/5 p-4 rounded'>
              <header class='flex gap-2 items-center'>
                <Image
                  src={picture}
                  alt={name}
                  width={56}
                  height={56}
                  format='avif'
                  class='size-14 rounded-full aspect-square'
                  decoding='async'
                  loading='lazy'
                />
                <div class='flex flex-col'>
                  <a href={linkedin} rel='noreferrer' target='_blank' class='hover:underline'>
                    <h5 class='text-lg font-bold'>{name}</h5>
                  </a>
                  <span class='text-base opacity-80'>{relation}</span>
                </div>
              </header>
              <p class='opacity-70 text-balance text-sm'>{text}</p>
            </article>
          </li>
        ))}
      </ul>
    )
  }
</article>

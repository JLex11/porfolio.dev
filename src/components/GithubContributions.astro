---
import ContributionsGrid from '@/components/ContributionsGrid.astro'
import type { ui } from '@/i18n/ui'
import { useTranslations } from '@/i18n/utils'
import { fetchContributions } from '@/utils/fetchContributions'

const currentLocale = Astro.currentLocale as keyof typeof ui
const t = useTranslations(currentLocale)

const data = await fetchContributions('JLex11')

Astro.response.headers.set('Cache-Control', 'public, max-age=3600, s-maxage=3600, stale-while-revalidate=86400')

const monthsRaw = t('section.github.months').split(',')
const subtitleText = t('section.github.subtitle').replace('{year}', String(data.year))
const monthsList = data.months.map((m) => ({
  ...m,
  name: monthsRaw[m.month] ?? '',
  isPassed: m.month <= data.currentMonth,
  isCurrent: m.month === data.currentMonth,
}))
---

<div
  id='github-contributions-card'
  class='contrib-card group relative overflow-hidden rounded-[1.25rem] border border-white/55 bg-white/45 px-5 pt-4 pb-6 shadow-[0_10px_40px_-10px_rgba(59,130,246,0.25),inset_0_1px_0_rgba(255,255,255,0.6)] [backdrop-filter:blur(18px)_saturate(1.3)] dark:border-slate-400/15 dark:bg-slate-900/45 dark:shadow-[0_10px_40px_-10px_rgba(59,130,246,0.20),inset_0_1px_0_rgba(255,255,255,0.05)]'
  data-months-data={JSON.stringify(data.months)}
  data-current-month={data.currentMonth}
  data-total-count={data.totalCount}
  data-year={data.year}
  data-locale={currentLocale}
  data-tooltip-tpl={t('section.github.tooltip')}
  data-tooltip-empty-tpl={t('section.github.tooltip.empty')}
>
  {/* Header bar */}
  <div class='mb-4 flex flex-wrap items-center justify-between gap-2 border-b border-slate-400/18 pb-3'>
    <div class='flex items-center gap-2'>
      <a
        href={`https://github.com/${data.username || 'JLex11'}`}
        target='_blank'
        rel='noopener noreferrer'
        class='flex items-center gap-1.5 font-mono text-[0.82rem] font-medium text-gray-700/90 transition-colors hover:text-blue-600 dark:text-slate-200/80 dark:hover:text-blue-400'
      >
        <svg class='size-4 fill-current' viewBox='0 0 24 24' aria-hidden='true'>
          <path
            fill-rule='evenodd'
            clip-rule='evenodd'
            d='M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z'
          />
        </svg>
        <span>@{data.username || 'JLex11'}</span>
      </a>
      <span class='rounded-full bg-blue-500/10 px-2 py-0.5 font-mono text-[0.7rem] font-semibold text-blue-600 dark:bg-blue-400/10 dark:text-blue-300'>
        {data.year}
      </span>
    </div>

    {/* Replay action button */}
    <button
      type='button'
      id='contrib-replay-btn'
      class='group/btn flex items-center gap-1.5 rounded-lg border border-slate-300/40 bg-white/60 px-2.5 py-1 text-[0.75rem] font-medium text-slate-600 shadow-sm transition-all hover:border-blue-500/30 hover:bg-blue-500/10 hover:text-blue-600 active:scale-95 dark:border-slate-700/50 dark:bg-slate-800/60 dark:text-slate-300 dark:hover:border-blue-400/30 dark:hover:bg-blue-400/10 dark:hover:text-blue-300'
      title={t('section.github.replay')}
      aria-label={t('section.github.replay')}
    >
      <svg
        class='size-3.5 transition-transform duration-500 group-hover/btn:rotate-180'
        fill='none'
        viewBox='0 0 24 24'
        stroke='currentColor'
        stroke-width='2'
      >
        <path stroke-linecap='round' stroke-linejoin='round' d='M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15' />
      </svg>
      <span>{t('section.github.replay')}</span>
    </button>
  </div>

  {/* Subtitle & Dynamic Counter */}
  <div class='mb-3 flex flex-wrap items-baseline justify-between gap-2'>
    <p class='text-[0.9rem] text-slate-600/90 dark:text-slate-300/85'>{subtitleText}</p>
    <div class='flex items-baseline gap-1.5 font-mono'>
      <span id='contrib-counter' class='text-xl font-bold tracking-tight text-blue-600 dark:text-blue-400'>
        {data.totalCount > 0 ? data.totalCount.toLocaleString(currentLocale) : '0'}
      </span>
      <span class='text-[0.8rem] text-slate-500 dark:text-slate-400'>
        {t('section.github.total.soFar').replace('{count}', '').trim()}
      </span>
    </div>
  </div>

  {/* Month progression pills */}
  <div id='contrib-month-pills' class='mb-4 flex flex-wrap items-center gap-1.5' role='tablist' aria-label='Meses del año'>
    {
      monthsList.map((m) => (
        <div
          data-month-pill={m.month}
          data-count={m.count}
          data-cumulative={m.cumulativeCount}
          class:list={[
            'contrib-month-pill flex items-center gap-1 rounded-full px-2 py-0.5 text-[0.7rem] font-medium transition-all duration-300 cursor-default select-none',
            m.isCurrent
              ? 'border border-blue-500/40 bg-blue-500/15 text-blue-600 dark:text-blue-300 ring-1 ring-blue-500/30'
              : m.isPassed
                ? 'border border-slate-300/40 bg-slate-100/70 text-slate-700 dark:border-slate-700/50 dark:bg-slate-800/60 dark:text-slate-300'
                : 'border border-transparent text-slate-400/40 dark:text-slate-600/40 opacity-40',
          ]}
        >
          <span>{m.name}</span>
          {m.isPassed && m.count > 0 && (
            <span class='text-[0.62rem] opacity-75 font-mono'>({m.count})</span>
          )}
        </div>
      ))
    }
  </div>

  {/* Grid */}
  <ContributionsGrid
    weeks={data.weeks}
    months={data.months}
    monthNames={monthsRaw}
    currentMonth={data.currentMonth}
    year={data.year}
    class='h-auto w-full supports-[animation-timeline:view()]:opacity-0 supports-[animation-timeline:view()]:transform-[translateY(2rem)_scale(0.96)] supports-[animation-timeline:view()]:animate-[contrib-card-rise_ease-out_both] supports-[animation-timeline:view()]:[animation-timeline:view(block)] supports-[animation-timeline:view()]:animate-range-[entry_10%_cover_40%]'
  />

  {/* Floating interactive tooltip */}
  <div
    id='contrib-tooltip'
    class='pointer-events-none absolute z-30 hidden -translate-x-1/2 -translate-y-full rounded-md border border-slate-700/60 bg-slate-900/95 px-2.5 py-1 text-[0.75rem] text-white shadow-xl backdrop-blur-md transition-opacity duration-150'
    role='tooltip'
    aria-hidden='true'
  >
  </div>
</div>

<script>
  function setupContributionsAnimation() {
    const card = document.getElementById('github-contributions-card')
    if (!card) return

    const counterEl = document.getElementById('contrib-counter')
    const replayBtn = document.getElementById('contrib-replay-btn')
    const tooltipEl = document.getElementById('contrib-tooltip')
    const gridSvg = card.querySelector('.contrib-grid')
    const pills = Array.from(card.querySelectorAll<HTMLElement>('.contrib-month-pill'))
    const headerLabels = Array.from(card.querySelectorAll<SVGTextElement>('.contrib-month-header-label'))
    const cells = Array.from(card.querySelectorAll<SVGRectElement>('.contrib-cell'))

    const currentMonth = Number(card.dataset.currentMonth ?? '11')
    const totalCount = Number(card.dataset.totalCount ?? '0')
    const monthsData = JSON.parse(card.dataset.monthsData || '[]')
    const locale = card.dataset.locale || 'es'
    const tooltipTpl = card.dataset.tooltipTpl || '{count} contribuciones el {date}'
    const tooltipEmptyTpl = card.dataset.tooltipEmptyTpl || 'Sin contribuciones el {date}'

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    let animationTimers: number[] = []
    let counterAnimationId: number | null = null
    let hasAnimated = false

    function clearAllTimers() {
      for (const timer of animationTimers) {
        window.clearTimeout(timer)
      }
      animationTimers = []
      if (counterAnimationId) {
        window.cancelAnimationFrame(counterAnimationId)
        counterAnimationId = null
      }
    }

    const activeCells = cells.filter((c) => c.dataset.future !== 'true' && Number(c.dataset.month) <= currentMonth)
    let maxActiveCol = 0
    const colContributions = new Map<number, number>()
    const colToMonth: number[] = []

    for (const cell of activeCells) {
      const col = Number(cell.dataset.col || '0')
      const count = Number(cell.dataset.count || '0')
      const month = Number(cell.dataset.month || '0')
      maxActiveCol = Math.max(maxActiveCol, col)
      colContributions.set(col, (colContributions.get(col) || 0) + count)
      colToMonth[col] = month
    }

    // Precalculate cumulative counts per column
    const colCumulative: number[] = []
    let runningColSum = 0
    for (let c = 0; c <= maxActiveCol; c++) {
      runningColSum += colContributions.get(c) || 0
      colCumulative[c] = runningColSum
    }

    const COL_SWEEP_MS = 80 // continuous sweep time per column (ms)
    const TOTAL_DURATION = (maxActiveCol + 1) * COL_SWEEP_MS

    function setMonthActiveState(mIndex: number) {
      // Update pills
      pills.forEach((pill) => {
        const pMonth = Number(pill.dataset.monthPill)
        const isPassed = pMonth <= mIndex
        const isCurrent = pMonth === mIndex

        pill.className = `contrib-month-pill flex items-center gap-1 rounded-full px-2 py-0.5 text-[0.7rem] font-medium transition-all duration-300 cursor-default select-none ${
          isCurrent
            ? 'border border-blue-500/40 bg-blue-500/20 text-blue-600 dark:text-blue-300 ring-2 ring-blue-500/40 scale-105 shadow-sm'
            : isPassed
              ? 'border border-slate-300/40 bg-slate-100/70 text-slate-700 dark:border-slate-700/50 dark:bg-slate-800/60 dark:text-slate-300'
              : 'border border-transparent text-slate-400/40 dark:text-slate-600/40 opacity-40'
        }`
      })

      // Update header labels
      headerLabels.forEach((label) => {
        const lMonth = Number(label.dataset.monthHeader)
        if (lMonth === mIndex) {
          label.classList.add('fill-blue-600', 'dark:fill-blue-300', 'font-bold')
        } else {
          label.classList.remove('fill-blue-600', 'dark:fill-blue-300', 'font-bold')
        }
      })
    }

    function runAnimation() {
      clearAllTimers()
      gridSvg?.classList.remove('is-finished')

      if (prefersReducedMotion) {
        for (const cell of activeCells) {
          cell.classList.add('is-revealed')
        }
        setMonthActiveState(currentMonth)
        if (counterEl) counterEl.textContent = totalCount.toLocaleString(locale)
        gridSvg?.classList.add('is-finished')
        return
      }

      // Reset all cells
      for (const cell of cells) {
        cell.classList.remove('is-revealed')
      }
      if (counterEl) counterEl.textContent = '0'
      setMonthActiveState(0)

      // Start continuous wave
      window.requestAnimationFrame(() => {
        for (const cell of activeCells) {
          cell.classList.add('is-revealed')
        }

        const startTime = performance.now()
        let lastReportedMonth = -1

        function tick(now: number) {
          const elapsed = now - startTime
          const progress = Math.min(1, elapsed / TOTAL_DURATION)
          const currentCol = Math.min(maxActiveCol, Math.floor(elapsed / COL_SWEEP_MS))
          const progressInCol = Math.min(1, (elapsed - currentCol * COL_SWEEP_MS) / COL_SWEEP_MS)

          // Smoothly track current active month along the timeline
          const monthAtCol = colToMonth[currentCol] ?? 0
          if (monthAtCol !== lastReportedMonth) {
            lastReportedMonth = monthAtCol
            setMonthActiveState(monthAtCol)
          }

          // Smooth continuous cumulative counter progression
          const prevSum = currentCol > 0 ? colCumulative[currentCol - 1] : 0
          const curSum = colCumulative[currentCol] ?? prevSum
          const currentCount = Math.min(totalCount, Math.round(prevSum + (curSum - prevSum) * progressInCol))

          if (counterEl) {
            counterEl.textContent = currentCount.toLocaleString(locale)
          }

          if (progress < 1) {
            counterAnimationId = window.requestAnimationFrame(tick)
          } else {
            // Completed sweep
            setMonthActiveState(currentMonth)
            if (counterEl) counterEl.textContent = totalCount.toLocaleString(locale)
            counterAnimationId = null

            const finishTimer = window.setTimeout(() => {
              gridSvg?.classList.add('is-finished')
            }, 450)
            animationTimers.push(finishTimer)
          }
        }

        counterAnimationId = window.requestAnimationFrame(tick)
      })
    }

    // Intersection observer to trigger animation when visible
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting && !hasAnimated) {
            hasAnimated = true
            runAnimation()
            observer.disconnect()
          }
        }
      },
      { threshold: 0.2 }
    )
    observer.observe(card)

    // Replay button listener
    replayBtn?.addEventListener('click', () => {
      runAnimation()
    })

    // Tooltip listeners
    for (const cell of cells) {
      cell.addEventListener('mouseenter', () => {
        if (!tooltipEl) return
        const count = Number(cell.dataset.count || '0')
        const date = cell.dataset.date || ''
        if (!date) return

        const formattedDate = new Date(`${date}T00:00:00`).toLocaleDateString(locale, {
          weekday: 'short',
          year: 'numeric',
          month: 'short',
          day: 'numeric',
        })

        const text =
          count > 0
            ? tooltipTpl.replace('{count}', count.toLocaleString(locale)).replace('{date}', formattedDate)
            : tooltipEmptyTpl.replace('{date}', formattedDate)

        tooltipEl.textContent = text
        tooltipEl.classList.remove('hidden')

        const cardRect = card.getBoundingClientRect()
        const cellRect = cell.getBoundingClientRect()

        const left = cellRect.left - cardRect.left + cellRect.width / 2
        const top = cellRect.top - cardRect.top - 8

        tooltipEl.style.left = `${left}px`
        tooltipEl.style.top = `${top}px`
      })

      cell.addEventListener('mouseleave', () => {
        if (!tooltipEl) return
        tooltipEl.classList.add('hidden')
      })
    }
  }

  // Setup on initial load & view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupContributionsAnimation)
  } else {
    setupContributionsAnimation()
  }

  document.addEventListener('astro:page-load', setupContributionsAnimation)
</script>
